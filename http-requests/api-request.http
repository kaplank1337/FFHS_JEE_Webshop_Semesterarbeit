### Benutzer-Workflow über den API Gateway
### Registrierung braucht einen noch nicht verwendeten Benutzernamen und eine neue E-Mail.
@baseUrl = http://localhost:8080/api-gateway-1.0.0/api
@username = new.user@example.com
@password = password123

### Benutzer erstellen
POST {{baseUrl}}/users/auth/register
Content-Type: application/json

{
  "username": "{{username}}",
  "email": "{{username}}",
  "password": "{{password}}",
  "firstName": "New",
  "lastName": "User"
}


### Login
### Login-Request zuerst ausführen; die Antwort speichert accessToken für Folge-Requests.
POST {{baseUrl}}/users/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}
> {%
const body = typeof response.body === "string"
  ? JSON.parse(response.body)
  : response.body;

if (response.status !== 200 || !body || !body.accessToken) {
  client.log("Login fehlgeschlagen: Antwort enthält kein accessToken.");
  client.exit();
}

client.global.set("auth_token", body.accessToken);
client.log("Login erfolgreich; JWT auth_token ist für Folge-Requests gespeichert.");
%}

### Angemeldeten Benutzer abrufen (JWT wird aus dem Login verwendet)
GET {{baseUrl}}/users/me
Authorization: Bearer {{auth_token}}


### Angemeldeten Benutzer löschen
### Der User-Service validiert das JWT und löscht nur dessen Benutzerkonto.
DELETE {{baseUrl}}/users/me
Authorization: Bearer {{auth_token}}

> {%
if (response.status === 204) {
  client.global.clear("auth_token");
}
%}
